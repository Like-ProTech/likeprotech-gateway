{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Clusters": {
      "auth-service-cluster": {
        "Destinations": {
          "Default": {
            "Address": "https://auth-service:7076/"
          }
        }
      },
      "todo-service-cluster": {
        "Destinations": {
          "Default": {
            "Address": "http://localhost:5222/"
          }
        }
      }

    },
    "Routes": [
      {
        "RouteId": "authentication-route",
        "ClusterId": "auth-service-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      {
        "RouteId": "todo-route",
        "ClusterId": "todo-service-cluster",
        "Match": {
          "Path": "/api/todos/{**catch-all}"
        }
      }
    ]
  }
}
